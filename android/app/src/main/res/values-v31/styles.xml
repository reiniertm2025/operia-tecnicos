<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 o más nuevo: pantalla de arranque azul marino con el ícono de la app (igual en claro y oscuro) -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/operia_marino</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/operia_marino</item>
        <item name="android:windowBackground">@color/operia_marino</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/operia_marino</item>
    </style>
</resources>
